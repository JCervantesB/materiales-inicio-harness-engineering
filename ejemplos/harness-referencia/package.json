{
  "name": "tareas",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dep-cruiser": "depcruise src",
    "test": "vitest run",
    "e2e": "playwright test",
    "pruebas-desactivadas": "node scripts/comprobar-pruebas-desactivadas.mjs",
    "verificar": "npm run typecheck && npm run lint && npm run dep-cruiser && npm run test && npm run pruebas-desactivadas",
    "verificar:todo": "npm run verificar && npm run e2e && npm run build"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.1.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@playwright/test": "^1.48.0",
    "dependency-cruiser": "^16.4.0"
  }
}
